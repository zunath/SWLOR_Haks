#MAXMODEL ASCII
# fifi1_x01_01 is the solid black filler tile around rooms. Without a walkmesh the engine treats the whole
# tile as walkable floor, so creatures pushed out of furniture against a room wall land in the void.
beginwalkmeshgeom fifi1_x01_01
node aabb walkmesh
  parent fifi1_x01_01
  position 0 0 0
  orientation 0 0 0 0
  wirecolor 0.839844 0.839844 0.839844
  ambient 1 1 1
  diffuse 1 1 1
  specular 0 0 0
  shininess 10
  bitmap NULL
  verts 4
    -5 -5 0
    5 -5 0
    -5 5 0
    5 5 0
  faces 2
    0 1 3  1  0 0 0  7
    0 3 2  1  0 0 0  7
  aabb     -5.00 -5.00 0.00   5.00 5.00 0.00   -1
     -5.00 -5.00 0.00   5.00 5.00 0.00   0
     -5.00 -5.00 0.00   5.00 5.00 0.00   1
endnode
endwalkmeshgeom fifi1_x01_01
