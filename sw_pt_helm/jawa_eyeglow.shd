/*
    Direct-atlas, colorable self-lit eyes for helm_063.
    The eye artwork and Leather 1 layer now live under the eye mesh UVs in
    helm_063.plt. This follows the verified player-droid glow architecture.
*/
#define SHADER_TYPE 2
#define LIGHTING 1
#define FOG 1
#define KEYHOLING 1
#define NORMAL_MAP 0
#define SPECULAR_MAP 0
#define ROUGHNESS_MAP 0
#define HEIGHT_MAP 0
#define SELF_ILLUMINATION_MAP 0
#define ENVIRONMENT_MAP 0

#include "inc_standard"

uniform sampler2D texUnit5;

void main ()
{
    FragmentColor = vec4(1.0);
    SetupStandardShaderInputs();

    // The PLT-resolved eye color now contains Leather 1 tint and eye detail.
    vec3 unlitTintedColor = max(FragmentColor.rgb, vec3(0.0));
    float tintPeak = max(max(unlitTintedColor.r, unlitTintedColor.g), unlitTintedColor.b);
    vec3 tintHue = unlitTintedColor / max(tintPeak, 0.001);

    ApplyStandardShader();

    float glowMask = texture2D(texUnit5, vTexCoords.xy).r;
    glowMask = smoothstep(0.10, 0.72, glowMask);

    // Same detail-preserving bright-end response as the verified droid heads.
    vec3 glowColor = unlitTintedColor * 1.75 + tintHue * 0.16;
    glowColor = glowColor / (vec3(1.0) + glowColor * 0.32);

    FragmentColor.rgb = mix(FragmentColor.rgb, glowColor, clamp(glowMask, 0.0, 1.0));
    gl_FragColor = FragmentColor;
}
