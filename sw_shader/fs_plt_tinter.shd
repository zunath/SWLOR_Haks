//=============================================================================
//
// fs_plt_tinter.shd
//
// Replaces a 3D model PLT with one compact ATI2/BC5 texture. The
// packed mask uses a content-addressed internal resref so it cannot resolve to
// an unrelated legacy diffuse texture with the original PLT's name.
//
// This base variant intentionally uses NWN's non-normal-mapped legacy lighting
// path. Materials with actual normal/specular inputs use fs_plt_tinter_nm.
//
// PACKED TINT MAP (texUnit7, internal tm_* resref):
//   R = shade/grey value
//   G = layer id encoded at the center of one of ten equal bins
//
// R uses regular filtering so shade gradients remain smooth. G is fetched at
// a nearest texel center using the MTR-provided dimensions, preventing a
// filtered seam from selecting the wrong dye layer.
//
// PALETTE ATLAS (texUnit10, plt_palette.tga, 256x2048 RGBA, mipmap 0):
//   U = (grey byte + 0.5) / 256, centered within the palette texel
//   V = (palette base + row + 0.5) / 2048, precomputed by script:
//     skin rows 0-175, hair 176-351, metal1 352-527,
//     metal2 528-703, cloth 704-879, leather 880-1055,
//     tattoo 1056-1231
//   A = the legacy palette's diffuse/environment-map coverage. This is not
//       cutout opacity; zero means the environment map replaces the diffuse.
//
// texture0 must still be bound (white placeholder) so the engine does
// not auto-assign; the white multiply is an identity op.
//
//=============================================================================

#define SHADER_TYPE 2

#define LIGHTING 1
#define FOG 1
#define KEYHOLING 1

#define NORMAL_MAP 0
#define SPECULAR_MAP 0
#define ROUGHNESS_MAP 0
#define HEIGHT_MAP 0
#define SELF_ILLUMINATION_MAP 0
#define ENVIRONMENT_MAP 1

#include "inc_standard"

uniform sampler2D texUnit7;
uniform sampler2D texUnit9;
uniform sampler2D texUnit10;
uniform float tintMapWidth;
uniform float tintMapHeight;
uniform float useTexture1Alpha;
uniform float useTexture9Alpha;

// Per-layer palette V coordinate (defaults = row 0 of each palette).
uniform float rowSkin   = 0.000244;
uniform float rowHair   = 0.086182;
uniform float rowMetal1 = 0.172119;
uniform float rowMetal2 = 0.258057;
uniform float rowCloth1 = 0.343994;
uniform float rowCloth2 = 0.343994;
uniform float rowLeath1 = 0.429932;
uniform float rowLeath2 = 0.429932;
uniform float rowTat1   = 0.515869;
uniform float rowTat2   = 0.515869;

// Optional direct RGB overrides. The mode uses its own scripted scalar because
// some clients do not retain a vec4's fourth component or a negative palette
// coordinate. A direct RGB tint is fully diffuse so it cannot inherit the
// hidden preset row's environment mask and turn chrome/grey.
uniform vec4 tintSkin   = vec4(0.0);
uniform vec4 tintHair   = vec4(0.0);
uniform vec4 tintMetal1 = vec4(0.0);
uniform vec4 tintMetal2 = vec4(0.0);
uniform vec4 tintCloth1 = vec4(0.0);
uniform vec4 tintCloth2 = vec4(0.0);
uniform vec4 tintLeath1 = vec4(0.0);
uniform vec4 tintLeath2 = vec4(0.0);
uniform vec4 tintTat1   = vec4(0.0);
uniform vec4 tintTat2   = vec4(0.0);

uniform float useCustomSkin   = 0.0;
uniform float useCustomHair   = 0.0;
uniform float useCustomMetal1 = 0.0;
uniform float useCustomMetal2 = 0.0;
uniform float useCustomCloth1 = 0.0;
uniform float useCustomCloth2 = 0.0;
uniform float useCustomLeath1 = 0.0;
uniform float useCustomLeath2 = 0.0;
uniform float useCustomTat1   = 0.0;
uniform float useCustomTat2   = 0.0;

void main ()
{
    vec2 tintMapSize = max(vec2(tintMapWidth, tintMapHeight), vec2(1.0));
    vec2 wrappedUV = fract(vVertexTexCoords);
    vec2 nearestUV = (floor(wrappedUV * tintMapSize) + vec2(0.5)) / tintMapSize;
    float g = texture2D(texUnit7, wrappedUV, -10.0).r;
    float encodedLayer = texture2D(texUnit7, nearestUV, -10.0).g;
    float layer = floor(clamp(encodedLayer, 0.0, 0.9999) * 10.0);

    float v = rowSkin;
    float referenceV = 0.000244;
    vec4 customTint = tintSkin;
    float customTintMode = useCustomSkin;
    if      (layer > 8.5) { v = rowTat2;   referenceV = 0.515869; customTint = tintTat2;   customTintMode = useCustomTat2; }
    else if (layer > 7.5) { v = rowTat1;   referenceV = 0.515869; customTint = tintTat1;   customTintMode = useCustomTat1; }
    else if (layer > 6.5) { v = rowLeath2; referenceV = 0.429932; customTint = tintLeath2; customTintMode = useCustomLeath2; }
    else if (layer > 5.5) { v = rowLeath1; referenceV = 0.429932; customTint = tintLeath1; customTintMode = useCustomLeath1; }
    else if (layer > 4.5) { v = rowCloth2; referenceV = 0.343994; customTint = tintCloth2; customTintMode = useCustomCloth2; }
    else if (layer > 3.5) { v = rowCloth1; referenceV = 0.343994; customTint = tintCloth1; customTintMode = useCustomCloth1; }
    else if (layer > 2.5) { v = rowMetal2; referenceV = 0.258057; customTint = tintMetal2; customTintMode = useCustomMetal2; }
    else if (layer > 1.5) { v = rowMetal1; referenceV = 0.172119; customTint = tintMetal1; customTintMode = useCustomMetal1; }
    else if (layer > 0.5) { v = rowHair;   referenceV = 0.086182; customTint = tintHair;   customTintMode = useCustomHair; }

    bool useCustomTint = customTintMode > 0.5;

    // Bias -10 forces mip level 0. The tintmap-derived UVs have chaotic
    // screen-space derivatives, so without this the GPU picks the smallest
    // mip (the whole-atlas average: a flat muddy color on every pixel).
    float paletteU = (g * 255.0 + 0.5) / 256.0;
    vec4 paletteColor = texture2D(texUnit10, vec2(paletteU, v), -10.0);
    // PLT intensity is a palette lookup coordinate, not a linear brightness.
    // Running custom RGB through raw `g` makes the independently-authored body
    // parts disagree at their joins and turns low skin values into black seams.
    // Use the first row of the appropriate native palette as a fixed, preset-
    // independent shade curve. Normalize at intensity 128, the same representative
    // midtone used by the preset swatches, so the chosen RGB means the same thing in
    // both halves of the picker while native shadows and highlights remain visible.
    vec3 referenceShade = texture2D(
        texUnit10,
        vec2(paletteU, referenceV),
        -10.0).rgb;
    vec3 referenceMidpoint = texture2D(
        texUnit10,
        vec2(128.5 / 256.0, referenceV),
        -10.0).rgb;
    const vec3 luminanceWeights = vec3(0.2126, 0.7152, 0.0722);
    float shadeScale = max(
        dot(referenceShade, luminanceWeights) /
            max(dot(referenceMidpoint, luminanceWeights), 1.0 / 255.0),
        0.0);
    vec3 vTint = useCustomTint
        ? clamp(customTint.rgb * shadeScale, 0.0, 1.0)
        : paletteColor.rgb;

    // Setup must see white so SetupSpecularity() derives SpecularColor the
    // same way fs_plt_hair did (FragmentColor was 1.0 there). The tint is
    // loaded right after -- ApplyStandardShader() is what consumes it.
    FragmentColor = vec4(1.0);

    SetupStandardShaderInputs();

    // texture0 is deliberately the opaque white placeholder, so the standard
    // setup cannot discover the PLT palette's environment-map coverage itself.
    // Reapply the same inc_standard path with the atlas alpha after normal-map
    // setup for presets. A custom RGB is independent of the hidden preset row,
    // including its environment mask.
    fEnvMapLevel = useCustomTint ? 0.0 : 1.0 - paletteColor.a;
    vec3 surfaceColor = ApplyColorSpace(vTint);

    #if FRAGMENT_LIGHTING == 1 && LIGHTING == 1
        surfaceColor = mix(
            surfaceColor,
            vec3(0.666667, 0.666667, 0.666667),
            fEnvMapLevel);
    #endif

    #if ENVIRONMENT_MAP == 1 && SPECULAR_LIGHT != 1
        vec3 environmentColor;
        #if FRAGMENT_NORMAL != 1
            if(envMapCube == 1)
                environmentColor = SampleEnvironmentMapCube(vVertexTexCoordsEnvironmentCube, 0.0);
            else
                environmentColor = SampleEnvironmentMap(vVertexTexCoordsEnvironment, 0.0);
        #else
            if(envMapCube == 1)
                environmentColor = SampleEnvironmentMapCube(
                    CalculateEnvironmentTexCoordsCube(vFragmentNormal), 0.0);
            else
                environmentColor = SampleEnvironmentMap(
                    CalculateEnvironmentTexCoords(vFragmentNormal), 0.0);
        #endif
        surfaceColor = mix(surfaceColor, environmentColor, fEnvMapLevel);
    #endif

    // Linearize before lighting; ApplyStandardShader() reverts at the end.
    FragmentColor = vec4(surfaceColor, 1.0);

    // A small number of legacy hair/fur materials encoded cutout opacity in
    // their normal-map alpha channel. Preserve it only when the MTR opts in.
    float outputAlpha = materialFrontDiffuse.a;
    if (useTexture1Alpha > 0.5)
    {
        outputAlpha *= texture2D(texUnit1, vTexCoords.xy).a;
        if (outputAlpha < 0.2)
            discard;
    }
    else if (useTexture9Alpha > 0.5)
    {
        outputAlpha = materialFrontDiffuse.a * texture2D(texUnit9, vTexCoords.xy).r;
        if (outputAlpha < 0.3)
            discard;
    }

    // Use the engine's standard material path so authored normal, specular,
    // roughness, self-illumination, and environment textures retain their
    // original behavior. Applying a separate default anisotropic pass here
    // makes ordinary PLT-only body parts look glossy and washes out the packed
    // tint-map detail.
    ApplyStandardShader();
    gl_FragColor = vec4(FragmentColor.rgb, outputAlpha);
}
