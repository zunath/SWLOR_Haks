#if NORMAL_MAP != 1
uniform sampler2D texUnit1;
#endif
uniform sampler2D texUnit6;
uniform sampler2D texUnit7;
uniform sampler2D texUnit8;
uniform sampler2D texUnit9;
uniform sampler2D texUnit10;
uniform float PLTscheme[15];
uniform float useNativePalette = 0.0;
uniform float tintMapWidth;
uniform float tintMapHeight;
uniform float useTexture1Alpha = 0.0;
uniform float useTexture9Alpha = 0.0;
uniform float rowSkin = 0.000244;
uniform float rowHair = 0.086182;
uniform float rowMetal1 = 0.172119;
uniform float rowMetal2 = 0.258057;
uniform float rowCloth1 = 0.343994;
uniform float rowCloth2 = 0.343994;
uniform float rowLeath1 = 0.429932;
uniform float rowLeath2 = 0.429932;
uniform float rowTat1 = 0.515869;
uniform float rowTat2 = 0.515869;
uniform float paletteFolded = 0.0;
uniform float skinGain = 1.0;
uniform float skinNeutralShade = 0.0;
uniform float hairGain = 1.0;
uniform float hairSaturation = 1.0;
uniform float hairShadePower = 1.0;
uniform float hairFilter = 0.0;
uniform float scalpShadeScale = 1.0;
uniform float scalpShadeBase = 0.070588235294;
uniform float scalpMaxU = 0.49;
uniform float scalpStartV = 0.45;
uniform float scalpEndV = 0.52;
uniform float hairMatte = 0.0;
uniform float hairReflectivity = 0.0;
uniform float clampEyeLayer = -1.0;
uniform float clampEyeLayer2 = -1.0;
uniform float eyeContour = 0.0;
uniform float lipMode = 0.0;
uniform float lipU0 = 0.0;
uniform float lipV0 = 0.0;
uniform float lipUSpan = 1.0;
uniform float lipVSpan = 1.0;
uniform float maskMode = 0.0;
uniform float alphaCutoff = 0.3;
uniform float maskSoftWidth = 0.08;
uniform float maskWrapUV = 0.0;
uniform float texture9Cutoff = 0.3;
uniform float forceOpaque = 0.0;
uniform float detailDiffuse = 0.0;
uniform float detailGlowChannel = 0.0;
uniform float detailGlowGain = 1.0;
uniform float glowMinLayer = -1.0;
uniform float glowMaxLayer = -1.0;
uniform float glowLayerFromMask = 0.0;
uniform float glowWholeSurface = 0.0;
uniform float glowGain = 1.75;
uniform float glowHueGain = 0.16;
uniform float glowCompression = 0.32;

vec4 HeadPalette(vec2 uv)
{
    if (paletteFolded > 0.5)
        uv = vec2((uv.x + floor(uv.y * 2.0)) * 0.5, fract(uv.y * 2.0));
    return texture2D(texUnit10, uv, -10.0);
}

float HeadHairShade(float g, vec2 uv, vec2 size)
{
    if (hairFilter > 0.5)
    {
        vec2 pixel = uv * size - vec2(0.5);
        vec2 base = floor(pixel);
        vec2 blend = fract(pixel);
        vec2 a = texture2D(texUnit7, (base + vec2(0.5)) / size, -10.0).rg;
        vec2 b = texture2D(texUnit7, (base + vec2(1.5, 0.5)) / size, -10.0).rg;
        vec2 c = texture2D(texUnit7, (base + vec2(0.5, 1.5)) / size, -10.0).rg;
        vec2 d = texture2D(texUnit7, (base + vec2(1.5)) / size, -10.0).rg;
        vec4 weights = vec4((1.0-blend.x)*(1.0-blend.y), blend.x*(1.0-blend.y),
                            (1.0-blend.x)*blend.y, blend.x*blend.y);
        weights *= vec4(float(a.g >= 0.1 && a.g < 0.2), float(b.g >= 0.1 && b.g < 0.2),
                        float(c.g >= 0.1 && c.g < 0.2), float(d.g >= 0.1 && d.g < 0.2));
        g = dot(vec4(a.r,b.r,c.r,d.r), weights) / max(dot(weights,vec4(1.0)),0.00001);
    }
    if (scalpShadeScale != 1.0 && uv.x < scalpMaxU)
    {
        float matchedShade = min(g, scalpShadeBase) + max(g-scalpShadeBase,0.0)*scalpShadeScale;
        g = mix(g,matchedShade,smoothstep(scalpStartV,scalpEndV,uv.y));
    }
    if (hairShadePower != 1.0)
        g = pow(clamp(g,0.0,1.0),hairShadePower);
    return g;
}

vec4 HeadTint(float layer, float g, vec2 uv, vec2 size)
{
    float v = rowSkin;
    if      (layer > 8.5) v = rowTat2;
    else if (layer > 7.5) v = rowTat1;
    else if (layer > 6.5) v = rowLeath2;
    else if (layer > 5.5) v = rowLeath1;
    else if (layer > 4.5) v = rowCloth2;
    else if (layer > 3.5) v = rowCloth1;
    else if (layer > 2.5) v = rowMetal2;
    else if (layer > 1.5) v = rowMetal1;
    else if (layer > 0.5) v = rowHair;
    if (v < 0.0 && useNativePalette > 0.5)
    {
        float colorId = mod(floor(PLTscheme[int(layer)]*1792.0+0.5),256.0);
        float baseRow = 0.0;
        if      (layer > 7.5) baseRow = 1056.0;
        else if (layer > 5.5) baseRow = 880.0;
        else if (layer > 3.5) baseRow = 704.0;
        else if (layer > 2.5) baseRow = 528.0;
        else if (layer > 1.5) baseRow = 352.0;
        else if (layer > 0.5) baseRow = 176.0;
        v = (baseRow+clamp(colorId,0.0,175.0)+0.5)/2048.0;
    }
    if (layer > 0.5 && layer < 1.5) g = HeadHairShade(g,uv,size);
    if (abs(layer-clampEyeLayer)<0.25 || abs(layer-clampEyeLayer2)<0.25)
        g = min(g,254.0/255.0);
    float paletteU = (g*255.0+0.5)/256.0;
    vec4 color = HeadPalette(vec2(paletteU,v));
    if (v >= 1.0 || (skinNeutralShade>0.5 && layer<0.5))
    {
        vec3 selected;
        if (v >= 1.0)
        {
            float bits = v<2.0 ? (v-1.0)*8388608.0 : (v-2.0)*4194304.0+8388608.0;
            selected = vec3(floor(bits/65536.0),mod(floor(bits/256.0),256.0),mod(bits,256.0))/255.0;
        }
        else selected = HeadPalette(vec2(128.5/256.0,v)).rgb;
        float referenceRow = 0.000244140625;
        if      (layer > 7.5) referenceRow = 0.515869140625;
        else if (layer > 5.5) referenceRow = 0.429931640625;
        else if (layer > 3.5) referenceRow = 0.343994140625;
        else if (layer > 2.5) referenceRow = 0.258056640625;
        else if (layer > 1.5) referenceRow = 0.172119140625;
        else if (layer > 0.5) referenceRow = 0.086181640625;
        vec3 reference = HeadPalette(vec2(paletteU,referenceRow)).rgb;
        vec3 midpoint = HeadPalette(vec2(128.5/256.0,referenceRow)).rgb;
        vec3 luminance = vec3(0.2126,0.7152,0.0722);
        float shade = max(dot(reference,luminance)/max(dot(midpoint,luminance),1.0/255.0),0.0);
        color = vec4(clamp(selected*shade,0.0,1.0),1.0);
    }
    if (layer < 0.5) color.rgb *= skinGain;
    if (layer > 0.5 && layer < 1.5)
        color.rgb = mix(vec3(dot(color.rgb,vec3(0.2126,0.7152,0.0722))),color.rgb,hairSaturation)*hairGain;
    return color;
}

vec3 HeadGlow(vec3 color)
{
    color = max(color,vec3(0.0));
    vec3 hue = color/max(max(max(color.r,color.g),color.b),0.001);
    vec3 emission = color*glowGain+hue*glowHueGain;
    return emission/(vec3(1.0)+emission*glowCompression);
}

void main()
{
    vec2 size = max(vec2(tintMapWidth,tintMapHeight),vec2(1.0));
    vec2 uv = fract(vVertexTexCoords);
    vec2 nearestUV = (floor(uv*size)+vec2(0.5))/size;
    float g = texture2D(texUnit7,uv,-10.0).r;
    float layer = floor(clamp(texture2D(texUnit7,nearestUV,-10.0).g,0.0,0.9999)*10.0);
    vec4 paletteColor = HeadTint(layer,g,uv,size);
    if (eyeContour>0.5 && (layer<0.5 || layer>8.5))
        paletteColor = mix(HeadTint(0.0,g,uv,size),HeadTint(9.0,g,uv,size),
                           clamp(texture2D(texUnit6,uv,-10.0).r,0.0,1.0));
    if (lipMode>0.5 && (layer<0.5 || (layer>6.5 && layer<7.5) || (lipMode>1.5 && lipMode<3.5)))
    {
        vec2 lipUV = (uv-vec2(lipU0,lipV0))/max(vec2(lipUSpan,lipVSpan),vec2(0.000001));
        float coverage = 0.0;
        float lipShade = g;
        if (lipMode>1.5 && lipMode<2.5)
            coverage = texture2D(texUnit6,uv,-10.0).r;
        else if (lipUV.x>=0.0 && lipUV.x<=1.0 && lipUV.y>=0.0 && lipUV.y<=1.0)
        {
            if (lipMode>2.5)
            {
                vec2 sampleValue = texture2D(texUnit9,lipUV,-10.0).rg;
                coverage = sampleValue.r;
                if (lipMode<3.5) lipShade = sampleValue.g;
            }
            else coverage = texture2D(texUnit8,lipUV,-10.0).r;
        }
        float baseLayer = (layer>6.5 && layer<7.5) ? 0.0 : layer;
        paletteColor = mix(HeadTint(baseLayer,g,uv,size),HeadTint(7.0,lipShade,uv,size),clamp(coverage,0.0,1.0));
    }
    vec3 vTint = paletteColor.rgb;
    vec2 detail = vec2(0.0);
    if (detailDiffuse>0.5 || detailGlowChannel>0.5)
    {
        detail = texture2D(texUnit8,uv).rg;
        if (detailDiffuse>0.5) vTint = mix(vTint,texture2D(texUnit0,uv).rgb,detail.r);
    }
    FragmentColor = vec4(1.0);
    SetupStandardShaderInputs();
    if (dot(vFragmentNormal,vFragmentNormal)<0.25 || !(vFragmentNormal.x==vFragmentNormal.x))
        vFragmentNormal = normalize(vSurfaceNormal);
    vec3 surfaceColor = ApplyColorSpace(vTint);
    #if ENVIRONMENT_MAP == 1
        fEnvMapLevel = (hairMatte>0.5 && layer>0.5 && layer<1.5) ? 0.0 : 1.0-paletteColor.a;
        #if FRAGMENT_LIGHTING == 1 && LIGHTING == 1
            surfaceColor = mix(surfaceColor,vec3(0.666667),fEnvMapLevel);
        #endif
        #if SPECULAR_LIGHT != 1
            vec3 environmentColor;
            #if FRAGMENT_NORMAL != 1
                if (envMapCube==1) environmentColor = SampleEnvironmentMapCube(vVertexTexCoordsEnvironmentCube,0.0);
                else environmentColor = SampleEnvironmentMap(vVertexTexCoordsEnvironment,0.0);
            #else
                if (envMapCube==1) environmentColor = SampleEnvironmentMapCube(CalculateEnvironmentTexCoordsCube(vFragmentNormal),0.0);
                else environmentColor = SampleEnvironmentMap(CalculateEnvironmentTexCoords(vFragmentNormal),0.0);
            #endif
            surfaceColor = mix(surfaceColor,environmentColor,fEnvMapLevel);
        #endif
    #else
        #if FRAGMENT_LIGHTING == 1 && LIGHTING == 1
            if (hairReflectivity>0.5 && layer>0.5 && layer<1.5)
                surfaceColor = mix(surfaceColor,vec3(0.666667),1.0-paletteColor.a);
        #endif
    #endif
    FragmentColor = vec4(surfaceColor,1.0);
    #if LIGHTING == 1 && (FRAGMENT_LIGHTING == 1 || NORMAL_MAP == 1) && SPECULAR_LIGHT == 1
        SetupSpecularity(FragmentColor.rgb*materialFrontDiffuse.rgb);
        if (hairMatte>0.5 && layer>0.5 && layer<1.5)
        {
            fSpecularity = 0.0;
            SpecularColor = vec3(0.0);
            fMetallicness = 0.0;
            fRoughness = 1.0;
        }
    #endif
    float outputAlpha = materialFrontDiffuse.a;
    if (useTexture1Alpha>0.5)
    {
        outputAlpha *= texture2D(texUnit1,vTexCoords.xy).a;
        if (outputAlpha<0.2) discard;
    }
    else if (useTexture9Alpha>0.5)
    {
        outputAlpha = materialFrontDiffuse.a*texture2D(texUnit9,vTexCoords.xy).r;
        if (outputAlpha<texture9Cutoff) discard;
    }
    if (maskMode>0.5)
    {
        vec2 maskUV = maskWrapUV>0.5 ? uv : vTexCoords.xy;
        vec4 mask = texture2D(texUnit6,maskUV);
        float coverage = maskMode>1.5 && maskMode<2.5 ? mask.a : mask.r;
        if (maskMode>3.5 && !(layer>0.5 && layer<1.5)) coverage = 1.0;
        if (maskMode>2.5)
        {
            float width = clamp(fwidth(coverage),1.0/255.0,maskSoftWidth);
            outputAlpha *= smoothstep(alphaCutoff-width,alphaCutoff+width,coverage);
            if (outputAlpha<=0.0) discard;
        }
        else if (coverage<alphaCutoff) discard;
    }
    if (forceOpaque>0.5) outputAlpha = 1.0;
    ApplyStandardShader();
    if (detailGlowChannel>0.5)
        FragmentColor.rgb = mix(FragmentColor.rgb,ApplyColorSpace(vTint)*detailGlowGain,
                               detailGlowChannel>1.5 ? detail.g : detail.r);
    float glowLayer = layer;
    if (glowLayerFromMask>0.5)
        glowLayer = floor(clamp(texture2D(texUnit9,nearestUV,-10.0).g,0.0,0.9999)*10.0);
    if (glowMinLayer>=0.0 && glowLayer>=glowMinLayer && glowLayer<=glowMaxLayer)
        FragmentColor.rgb = HeadGlow(vTint);
    if (glowWholeSurface>0.5)
        FragmentColor.rgb = HeadGlow(FragmentColor.rgb);
    gl_FragColor = vec4(FragmentColor.rgb,outputAlpha);
}
