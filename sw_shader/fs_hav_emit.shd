//=============================================================================
//
// fs_plt_tinter_nm.shd
//
// Normal/specular-mapped variant of fs_plt_tinter. The base shader deliberately
// follows NWN's legacy PLT-only lighting path; this variant is selected only
// when an authored material actually supplies mapped inputs.
//
//=============================================================================

#define SHADER_TYPE 2

#define LIGHTING 1
#define FOG 1
#define KEYHOLING 1

#define NORMAL_MAP 1
#define SPECULAR_MAP 1
#define ROUGHNESS_MAP 1
#define HEIGHT_MAP 0
#define SELF_ILLUMINATION_MAP 0
#define ENVIRONMENT_MAP 1

#include "inc_standard"

uniform sampler2D texUnit7;
uniform sampler2D texUnit9;
uniform sampler2D texUnit10;

// ProgFX coatings (stoneskin, barkskin, Shadow Shield and the like) swap a legacy
// mesh's diffuse texture for the effect's vdu_tex_* texture. The client never
// swaps this material's textures, so the server sets progFxCoat to the coat's
// cell in the progfx_coat atlas plus one while such an effect is active.
uniform sampler2D texUnit8;
uniform float progFxCoat;

vec4 SampleProgFxCoat(vec2 uv)
{
    // Four by two cells of 256 texels; each cell repeats like its source texture.
    float cell = floor(progFxCoat + 0.5) - 1.0;
    vec2 cellOrigin = vec2(mod(cell, 4.0), floor(cell / 4.0));
    vec2 cellUV = clamp(fract(uv), vec2(2.0 / 256.0), vec2(254.0 / 256.0));
    vec2 atlasUV = (cellOrigin + cellUV) / vec2(4.0, 2.0);
#if __VERSION__ >= 130
    // Gradients of the unwrapped coordinates keep one mip level across the
    // repeat seam. Capping them at mip 2 keeps neighbouring cells out.
    vec2 gradX = dFdx(uv) / vec2(4.0, 2.0);
    vec2 gradY = dFdy(uv) / vec2(4.0, 2.0);
    gradX *= min(1.0, (4.0 / 1024.0) / max(length(gradX), 1e-8));
    gradY *= min(1.0, (4.0 / 1024.0) / max(length(gradY), 1e-8));
    return textureGrad(texUnit8, atlasUV, gradX, gradY);
#else
    return texture2D(texUnit8, atlasUV);
#endif
}
uniform float PLTscheme[15];
uniform float useNativePalette;
uniform float smoothTintEdges;
uniform float tintMapWidth;
uniform float tintMapHeight;
uniform float useTexture1Alpha;
uniform float useTexture9Alpha;
uniform float useAuthoredDiffuse = 0.0;

// Per-layer scalar color: a palette V coordinate below one, or exact RGB in [1, 4).
uniform float rowSkin   = 0.000244;
uniform float rowHair   = 0.086182;
uniform float rowMetal1 = 0.172119;
uniform float rowMetal2 = 0.258057;
uniform float rowCloth1 = 0.343994;
uniform float rowCloth2 = 0.343994;
uniform float rowLeath1 = 0.429932;
uniform float rowLeath2 = 0.429932;
uniform float rowTat1   = 0.515869;
uniform float rowTat2   = 0.515869;

vec4 ResolveTintColor(float g, float layer, vec3 authoredDiffuse)
{
    float v = rowSkin;
    if      (layer > 8.5) { v = rowTat2;   }
    else if (layer > 7.5) { v = rowTat1;   }
    else if (layer > 6.5) { v = rowLeath2; }
    else if (layer > 5.5) { v = rowLeath1; }
    else if (layer > 4.5) { v = rowCloth2; }
    else if (layer > 3.5) { v = rowCloth1; }
    else if (layer > 2.5) { v = rowMetal2; }
    else if (layer > 1.5) { v = rowMetal1; }
    else if (layer > 0.5) { v = rowHair;   }

    // Robe meshes are omitted from the client's custom-uniform replay. Only
    // materials with a native PLT control resource enable this fallback, since
    // materials without a scheme can inherit stale renderer scheme values.
    // Nonnegative script rows, including palette color zero, always take priority.
    if (v < 0.0 && useNativePalette > 0.5)
    {
        // Native schemes store (256-row palette block OR color byte) / 1792.
        float colorId = mod(floor(PLTscheme[int(layer)] * 1792.0 + 0.5), 256.0);
        float baseRow = 0.0;
        if      (layer > 7.5) { baseRow = 1056.0; }
        else if (layer > 5.5) { baseRow = 880.0;  }
        else if (layer > 3.5) { baseRow = 704.0;  }
        else if (layer > 2.5) { baseRow = 528.0;  }
        else if (layer > 1.5) { baseRow = 352.0;  }
        else if (layer > 0.5) { baseRow = 176.0;  }
        v = (baseRow + clamp(colorId, 0.0, 175.0) + 0.5) / 2048.0;
    }

    float paletteU = (g * 255.0 + 0.5) / 256.0;
    vec4 paletteColor = texture2D(texUnit10, vec2(paletteU, v), -10.0);
    // Values below one remain untouched palette coordinates. Custom RGB uses the
    // two adjacent IEEE float intervals [1, 2) and [2, 4), carrying all 24 bits.
    // This is the inverse of TintMapShaderColor.Encode on the server.
    if (v >= 1.0)
    {
        float rgbBits = v < 2.0
            ? (v - 1.0) * 8388608.0
            : (v - 2.0) * 4194304.0 + 8388608.0;
        vec3 decodedRgb = vec3(floor(rgbBits / 65536.0),
            mod(floor(rgbBits / 256.0), 256.0), mod(rgbBits, 256.0)) / 255.0;
        // Shade exact RGB with the row of its nearest palette swatch (the shade-128
        // midtone the editor shows). Atlas rows 1536-2047 map each 32-level RGB cell
        // to up to three candidate swatches in palette order (palette_swatch_lookup
        // in GenerateTintMapAssets.py). The nearest candidate wins, the earlier one
        // on a tie, like the editor's closest-swatch lookup. A color equal to a
        // swatch renders exactly like that palette color, reflection included;
        // other colors take the row's contrast and its shade-by-shade change of
        // hue and saturation, applied to their own chroma, instead of a single
        // light reference curve.
        float paletteBase = 0.0;
        float lookupBase = 1536.0;
        if      (layer > 7.5) { paletteBase = 1056.0; lookupBase = 1920.0; }
        else if (layer > 5.5) { paletteBase = 880.0;  lookupBase = 1920.0; }
        else if (layer > 3.5) { paletteBase = 704.0;  lookupBase = 1920.0; }
        else if (layer > 2.5) { paletteBase = 528.0;  lookupBase = 1792.0; }
        else if (layer > 1.5) { paletteBase = 352.0;  lookupBase = 1792.0; }
        else if (layer > 0.5) { paletteBase = 176.0;  lookupBase = 1664.0; }
        vec3 lookupCell = floor(decodedRgb * 31.0 + 0.5);
        float cellIndex = lookupCell.r * 1024.0 + lookupCell.g * 32.0 + lookupCell.b;
        float lookupRow = lookupBase + floor(cellIndex / 256.0);
        float lookupColumn = cellIndex - floor(cellIndex / 256.0) * 256.0;
        vec3 candidates = floor(texture2D(texUnit10, vec2((lookupColumn + 0.5) / 256.0,
            (lookupRow + 0.5) / 2048.0), -10.0).rgb * 255.0 + 0.5);
        float swatchIndex = candidates.r;
        vec3 swatchMidpoint = texture2D(texUnit10,
            vec2(128.5 / 256.0, (paletteBase + candidates.r + 0.5) / 2048.0), -10.0).rgb;
        vec3 candidateMidpoint = texture2D(texUnit10,
            vec2(128.5 / 256.0, (paletteBase + candidates.g + 0.5) / 2048.0), -10.0).rgb;
        if (dot(candidateMidpoint - decodedRgb, candidateMidpoint - decodedRgb) <
            dot(swatchMidpoint - decodedRgb, swatchMidpoint - decodedRgb))
        {
            swatchIndex = candidates.g;
            swatchMidpoint = candidateMidpoint;
        }
        candidateMidpoint = texture2D(texUnit10,
            vec2(128.5 / 256.0, (paletteBase + candidates.b + 0.5) / 2048.0), -10.0).rgb;
        if (dot(candidateMidpoint - decodedRgb, candidateMidpoint - decodedRgb) <
            dot(swatchMidpoint - decodedRgb, swatchMidpoint - decodedRgb))
        {
            swatchIndex = candidates.b;
            swatchMidpoint = candidateMidpoint;
        }
        vec4 swatchShade = texture2D(texUnit10,
            vec2(paletteU, (paletteBase + swatchIndex + 0.5) / 2048.0), -10.0);
        vec3 luminance = vec3(0.2126, 0.7152, 0.0722);
        // A swatch darker than two levels lends no usable shading: the black rows
        // have none, and skin row 31 rises from a 1-level midtone to white, a
        // ratio that would turn a near-black dye white. The duplicate black rows
        // also differ only in reflection (cloth row 57 is half-reflective), which
        // a custom color cannot choose. Shade the color with the layer's first
        // palette row and take that row's coverage, so black and near-black dyes
        // stay a matte black instead of a grey reflection.
        if (dot(swatchMidpoint, luminance) < 2.0 / 255.0)
        {
            swatchShade = texture2D(texUnit10,
                vec2(paletteU, (paletteBase + 0.5) / 2048.0), -10.0);
            swatchMidpoint = texture2D(texUnit10,
                vec2(128.5 / 256.0, (paletteBase + 0.5) / 2048.0), -10.0).rgb;
        }
        float shadeScale = max(dot(swatchShade.rgb, luminance) /
            max(dot(swatchMidpoint, luminance), 1.0 / 255.0), 0.0);
        // The swatch's contrast scales the color's own luminance. Its change of hue
        // and saturation across the shades is applied relative to the color's own
        // chroma (the color minus its luminance grey, as a complex number in the
        // plane orthogonal to the luminance weights): the row's chroma at this
        // shade over its midtone chroma, times the color's chroma. A neutral color
        // therefore stays neutral on a colored swatch's row. A nearly neutral
        // swatch has no reliable hue, so its ratio fades to plain scaling below
        // about 8 levels of chroma, and the rest of its row is added back only for
        // colors within 16 levels of it. A color equal to a swatch still renders
        // exactly like that palette row.
        vec3 chromaU = vec3(0.675495915, -0.127481049, -0.726260181);
        vec3 chromaV = vec3(-0.680638933, 0.271037427, -0.680638933);
        vec3 colorGrey = decodedRgb - vec3(dot(decodedRgb, luminance));
        vec3 midpointGrey = swatchMidpoint - vec3(dot(swatchMidpoint, luminance));
        vec3 shadeGrey = swatchShade.rgb - vec3(dot(swatchShade.rgb, luminance));
        vec2 colorChroma = vec2(dot(colorGrey, chromaU), dot(colorGrey, chromaV));
        vec2 midpointChroma = vec2(dot(midpointGrey, chromaU), dot(midpointGrey, chromaV));
        vec2 shadeChroma = vec2(dot(shadeGrey, chromaU), dot(shadeGrey, chromaV));
        float midpointChromaSquared = dot(midpointChroma, midpointChroma);
        float chromaWeight = 1.0 / (midpointChromaSquared + 0.000984237);
        float confidence = midpointChromaSquared * chromaWeight;
        vec2 relativeChroma = vec2(dot(colorChroma, midpointChroma),
            colorChroma.y * midpointChroma.x - colorChroma.x * midpointChroma.y) * chromaWeight;
        vec2 shadedChroma = colorChroma * (shadeScale * (1.0 - confidence)) +
            vec2(shadeChroma.x * relativeChroma.x - shadeChroma.y * relativeChroma.y,
                shadeChroma.x * relativeChroma.y + shadeChroma.y * relativeChroma.x);
        float nearSwatch = clamp(1.0 - distance(decodedRgb, swatchMidpoint) * 255.0 / 16.0, 0.0, 1.0);
        shadedChroma += (shadeChroma - midpointChroma * shadeScale) * ((1.0 - confidence) * nearSwatch);
        vec3 shadedRgb = vec3(dot(decodedRgb, luminance) * shadeScale) +
            chromaU * shadedChroma.x + chromaV * shadedChroma.y;
        // Reflection coverage fades from the swatch row's (within half a level of
        // the swatch) to the layer's first palette row's (8 levels away). A color
        // equal to a swatch keeps that palette color's reflection, and neighbouring
        // colors whose nearest swatch changes no longer flip between the metal
        // palette's shiny (0.5) and painted (0.8) rows, which turned dark metal
        // grey or silver.
        float firstAlpha = texture2D(texUnit10,
            vec2(paletteU, (paletteBase + 0.5) / 2048.0), -10.0).a;
        float environmentAlpha = firstAlpha + (swatchShade.a - firstAlpha) *
            clamp((8.0 - distance(decodedRgb, swatchMidpoint) * 255.0) / 7.5, 0.0, 1.0);
        // Only explicit RGB replaces the hue; the diffuse still supplies all detail.
        // Metal keeps the layer's first palette row's reflection coverage.
        if (useAuthoredDiffuse > 0.5)
        {
            shadedRgb = decodedRgb * (dot(authoredDiffuse, luminance) / 0.5);
            environmentAlpha = layer > 1.5 && layer < 3.5
                ? texture2D(texUnit10, vec2(paletteU, (paletteBase + 0.5) / 2048.0), -10.0).a : 1.0;
        }
        paletteColor = vec4(clamp(shadedRgb, 0.0, 1.0), environmentAlpha);
    }
    // These surfaces originally ignored native palette dyes. Preserve that
    // appearance until an exact RGB override is supplied, including after reset.
    if (useAuthoredDiffuse > 0.5 && v < 1.0)
        paletteColor = vec4(authoredDiffuse, 1.0);
    return paletteColor;
}

vec4 ResolveTintTexel(vec2 uv, vec3 authoredDiffuse)
{
    // uv is a texel centre. Fetch that texel exactly: anisotropic filtering
    // on the mipmapped mask would blend its layer id with a neighbour's.
#if __VERSION__ >= 130
    vec2 tintSize = max(vec2(tintMapWidth, tintMapHeight), vec2(1.0));
    ivec2 tintTexel = ivec2(mod(floor(uv * tintSize), tintSize));
    vec2 packedTint = texelFetch(texUnit7, tintTexel, 0).rg;
#else
    vec2 packedTint = texture2D(texUnit7, uv, -10.0).rg;
#endif
    float layer = floor(clamp(packedTint.g, 0.0, 0.9999) * 10.0);
    return ResolveTintColor(packedTint.r, layer, authoredDiffuse);
}


uniform sampler2D texUnit5;
uniform sampler2D texUnit6;
uniform float glowLayer = 7.0;
uniform float glowOverlay = 0.0;

void ApplyHavocShader(vec3 emission)
{
	#if LIGHTING == 1

		#if FRAGMENT_LIGHTING == 1 || FRAGMENT_NORMAL == 1

			ComputeLighting(FragmentColor, vFragmentNormal);
		#else

			#if SELF_ILLUMINATION_MAP == 1
				#if MATERIAL_READ_SELF_ILLUMINATION_FROM_SPECULAR_MAP == 1
					if(texture2Bound != 0)
					{
						FragmentColor.rgb *= FragmentColor.rgb * (VertexColor.rgb + texture2D(texUnit2, vTexCoords).b);
						FragmentColor.a *= VertexColor.a;
					}
				#else
					if(texture5Bound != 0)
					{
						FragmentColor.rgb *= FragmentColor.rgb * (VertexColor.rgb + texture2D(texUnit5, vTexCoords).r);
						FragmentColor.a *= VertexColor.a;
					}
				#endif
				else
			#endif
			{
				FragmentColor *= VertexColor;
			}

		#endif

	#endif

    FragmentColor.rgb += ApplyColorSpace(emission);

	#if KEYHOLING == 1
		ApplyKeyhole(FragmentColor);
	#endif

	FragmentColor.rgb = RevertColorSpace(FragmentColor.rgb);

	#if FOG == 1
		ApplyFog(FragmentColor);
	#endif

	#if GAMMA_CORRECTION == 1
		#if COLOR_CORRECTION_TYPE == 1
		FragmentColor = ColorClamp(FragmentColor);
		#elif COLOR_CORRECTION_TYPE == 2
		FragmentColor.rgb = ACESFilm(FragmentColor.rgb);
		#endif
	#endif

	// DEBUG
	ApplyDebugModeOutput(FragmentColor);

}

void main ()
{
    vec2 tintMapSize = max(vec2(tintMapWidth, tintMapHeight), vec2(1.0));
    vec2 wrappedUV = fract(vVertexTexCoords);
    vec2 nearestUV = (floor(wrappedUV * tintMapSize) + vec2(0.5)) / tintMapSize;
    // Up close each texel keeps its own exact shade (bias -10 is level 0).
    // Once a texel shrinks below a pixel, blend to the mask's mipmaps, which
    // average the shades a far pixel covers, so cloth does not glitter.
    // A mipmapped shade up close would mix shades across a dye border.
    vec2 texels = vVertexTexCoords * tintMapSize;
    float far = clamp(max(length(dFdx(texels)), length(dFdy(texels))) - 1.0, 0.0, 1.0);
    float g = mix(texture2D(texUnit7, wrappedUV, -10.0).r,
        texture2D(texUnit7, vVertexTexCoords).r, far);
    // The layer id is a category: fetch the one texel, never filtered.
    // Once the mask has mipmaps, anisotropic filtering samples several
    // texels even at level 0 and blends two layer ids into a wrong one.
#if __VERSION__ >= 130
    ivec2 tintTexel = clamp(ivec2(wrappedUV * tintMapSize), ivec2(0), ivec2(tintMapSize) - 1);
    float encodedLayer = texelFetch(texUnit7, tintTexel, 0).g;
#else
    float encodedLayer = texture2D(texUnit7, nearestUV, -10.0).g;
#endif
    float layer = floor(clamp(encodedLayer, 0.0, 0.9999) * 10.0);
    // Authored raster materials retain their original atlas at full resolution.
    // Let the sampler repeat so UV derivatives stay continuous for mip selection.
    vec3 authoredDiffuse = vec3(1.0);
    if (useAuthoredDiffuse > 0.5)
        authoredDiffuse = texture2D(texUnit0, vVertexTexCoords).rgb;
    vec4 paletteColor = ResolveTintColor(g, layer, authoredDiffuse);
    if (smoothTintEdges > 0.5)
    {
        // Native PLTs filter the resolved colors, not their categorical layer IDs.
        // Resolve each neighboring texel first so dye edges blend with the
        // correct material without inventing a third dye or losing metal coverage.
        vec2 texelPosition = wrappedUV * tintMapSize - vec2(0.5);
        vec2 baseUV = (floor(texelPosition) + vec2(0.5)) / tintMapSize;
        vec2 stepUV = vec2(1.0) / tintMapSize;
        vec2 blend = fract(texelPosition);
        vec4 lower = mix(ResolveTintTexel(baseUV, authoredDiffuse),
            ResolveTintTexel(baseUV + vec2(stepUV.x, 0.0), authoredDiffuse), blend.x);
        vec4 upper = mix(ResolveTintTexel(baseUV + vec2(0.0, stepUV.y), authoredDiffuse),
            ResolveTintTexel(baseUV + stepUV, authoredDiffuse), blend.x);
        paletteColor = mix(lower, upper, blend.y);
    }
    vec3 vTint = paletteColor.rgb;

    FragmentColor = vec4(1.0);
    SetupStandardShaderInputs();

    if (dot(vFragmentNormal, vFragmentNormal) < 0.25 ||
        !(vFragmentNormal.x == vFragmentNormal.x))
    {
        vFragmentNormal = normalize(vSurfaceNormal);
    }

    fEnvMapLevel = 1.0 - paletteColor.a;
    vec3 surfaceColor = vTint;
    bool progFxCoated = progFxCoat > 0.5;
    if (progFxCoated)
    {
        // As on the client's legacy path, the coat replaces the diffuse color
        // and its alpha sets the environment-map coverage.
        vec4 coat = SampleProgFxCoat(vTexCoords.xy);
        surfaceColor = coat.rgb;
        fEnvMapLevel = 1.0 - coat.a;
    }

    #if FRAGMENT_LIGHTING == 1 && LIGHTING == 1
        surfaceColor = mix(
            surfaceColor,
            vec3(0.666667, 0.666667, 0.666667),
            fEnvMapLevel);
    #endif

    // NWN blends legacy reflection in texture space, then linearizes.
    // Blending into linear RGB brightens dark hair and metal palette colors.
    surfaceColor = ApplyColorSpace(surfaceColor);

    #if ENVIRONMENT_MAP == 1 && SPECULAR_LIGHT != 1
        vec3 environmentColor;
        #if FRAGMENT_NORMAL != 1
            if(envMapCube == 1)
                environmentColor = SampleEnvironmentMapCube(vVertexTexCoordsEnvironmentCube, 0.0);
            else
                environmentColor = SampleEnvironmentMap(vVertexTexCoordsEnvironment, 0.0);
        #else
            if(envMapCube == 1)
                environmentColor = SampleEnvironmentMapCube(
                    CalculateEnvironmentTexCoordsCube(vFragmentNormal), 0.0);
            else
                environmentColor = SampleEnvironmentMap(
                    CalculateEnvironmentTexCoords(vFragmentNormal), 0.0);
        #endif
        if (progFxCoated)
        {
            // The client also binds the coat texture as the environment map.
            #if FRAGMENT_NORMAL != 1
                environmentColor = ApplyColorSpace(SampleProgFxCoat(vVertexTexCoordsEnvironment).rgb);
            #else
                environmentColor = ApplyColorSpace(SampleProgFxCoat(
                    CalculateEnvironmentTexCoords(vFragmentNormal)).rgb);
            #endif
        }
        surfaceColor = mix(surfaceColor, environmentColor, fEnvMapLevel);
    #endif

    FragmentColor = vec4(surfaceColor, 1.0);

    // Replace specular state derived from the placeholder or missing-texture
    // fallback with the final palette coverage and diffuse color. Standard
    // setup still honors authored specular/roughness maps and material values.
    #if LIGHTING == 1 && (FRAGMENT_LIGHTING == 1 || NORMAL_MAP == 1) && SPECULAR_LIGHT == 1
        SetupSpecularity(FragmentColor.rgb * materialFrontDiffuse.rgb);
    #endif

    float outputAlpha = materialFrontDiffuse.a;
    if (useTexture1Alpha > 0.5)
    {
        outputAlpha *= texture2D(texUnit1, vTexCoords.xy).a;
        if (outputAlpha < 0.2)
            discard;
    }
    else if (useTexture9Alpha > 0.5)
    {
        outputAlpha = materialFrontDiffuse.a * texture2D(texUnit9, vTexCoords.xy).r;
        if (outputAlpha < 0.3)
            discard;
    }

    vec3 fixedEmission = texture2D(texUnit5, vTexCoords.xy).rgb;
    float strength = max(fixedEmission.r, max(fixedEmission.g, fixedEmission.b));
    vec3 glowColor = ResolveTintColor(128.0 / 255.0, glowLayer, vec3(1.0)).rgb;
    ApplyHavocShader(glowColor * strength);
    gl_FragColor = vec4(FragmentColor.rgb, outputAlpha);
}
