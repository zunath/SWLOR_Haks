// Cloth1 player-colorable glow overlay; non-mask fragments are discarded.
#define SHADER_TYPE 2

#define FOG 1
#define KEYHOLING 1
#define LIGHTING 1

#define NORMAL_MAP 0
#define SPECULAR_MAP 0
#define ROUGHNESS_MAP 0
#define HEIGHT_MAP 0
#define SELF_ILLUMINATION_MAP 0
#define ENVIRONMENT_MAP 0

#include "inc_standard"

uniform sampler2D texUnit6;

void main ()
{
    FragmentColor = vec4(1.0);
    SetupStandardShaderInputs();

    vec3 pltColor = FragmentColor.rgb;
    float glowMask = texture2D(texUnit6, vTexCoords.xy).r;
    if (glowMask < 0.50) discard;

    ApplyStandardShader();
    vec3 tintEmission = pltColor * glowMask * 1.25;
    FragmentColor.rgb = min(FragmentColor.rgb + tintEmission, vec3(1.0));
    gl_FragColor = FragmentColor;
}
