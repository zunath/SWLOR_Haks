/*=============================================================================
    pfo0_head021.shd
    PLT cutout shader using a separate black/white mask in texture6.
=============================================================================*/

#define SHADER_TYPE 2

#define LIGHTING 1
#define FOG 1
#define KEYHOLING 1

#define NORMAL_MAP 1
#define SPECULAR_MAP 1
#define ROUGHNESS_MAP 0
#define HEIGHT_MAP 0
#define SELF_ILLUMINATION_MAP 0
#define ENVIRONMENT_MAP 0

#include "inc_standard"

// inc_standard does not declare texUnit6 for this fragment-shader setup.
// Declare the MTR texture6 sampler explicitly.
uniform sampler2D texUnit6;

void main ()
{
    FragmentColor = vec4(1.0);
    SetupStandardShaderInputs();

    float fCutout = texture2D(texUnit6, vTexCoords.xy).r;

    if (fCutout < 0.5)
    {
        discard;
    }

    ApplyStandardShader();
    gl_FragColor = vec4(FragmentColor.rgb, 1.0);
}
