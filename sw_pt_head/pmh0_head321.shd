/*=============================================================================
    pmh0_head321.shd
    Diffuse-only cutout transparency shader for slot 321 hair.
    Uses external alpha mask in texture6. Intended for hard-cut transparency
    only; no blended glass or separate eyebrow material.
=============================================================================*/

#define SHADER_TYPE 2
#define LIGHTING 1
#define FOG 1
#define KEYHOLING 1
#define NORMAL_MAP 0
#define SPECULAR_MAP 0
#define ROUGHNESS_MAP 0
#define HEIGHT_MAP 0
#define SELF_ILLUMINATION_MAP 0
#define ENVIRONMENT_MAP 0

#include "inc_standard"

uniform sampler2D texUnit6;

void main ()
{
    FragmentColor = vec4(1.0);
    SetupStandardShaderInputs();

    float alphaMask = texture2D(texUnit6, vTexCoords.xy).r;
    if (alphaMask < 0.5)
    {
        discard;
    }

    ApplyStandardShader();
    gl_FragColor = vec4(FragmentColor.rgb, 1.0);
}
