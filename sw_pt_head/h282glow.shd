// Head 282 Cyber implant LED overlay.
// The short resource name is intentional: NWN runtime resources must be <= 16 characters.
#define SHADER_TYPE 2
#define LIGHTING 1
#define FOG 1
#define KEYHOLING 1
#define NORMAL_MAP 0
#define SPECULAR_MAP 0
#define ROUGHNESS_MAP 0
#define HEIGHT_MAP 0
#define SELF_ILLUMINATION_MAP 0
#define ENVIRONMENT_MAP 0

#include "inc_standard"

void main ()
{
    FragmentColor = vec4(1.0);
    SetupStandardShaderInputs();

    // Capture the PLT-resolved Cloth 1 colour before scene lighting.  This is
    // the same ordering used by the verified Jawa and player-droid glow paths.
    vec3 unlitTintedColor = max(FragmentColor.rgb, vec3(0.0));
    float tintPeak = max(max(unlitTintedColor.r, unlitTintedColor.g), unlitTintedColor.b);
    vec3 tintHue = unlitTintedColor / max(tintPeak, 0.001);

    ApplyStandardShader();

    // This material contains only the two LED meshes, so its full surface is
    // emissive.  Retain the selected Cloth 1 hue while adding enough light for
    // dark player choices to stay visibly illuminated.
    vec3 glowColor = unlitTintedColor * 1.75 + tintHue * 0.16;
    glowColor = glowColor / (vec3(1.0) + glowColor * 0.32);
    FragmentColor = vec4(glowColor, 1.0);
    gl_FragColor = FragmentColor;
}
